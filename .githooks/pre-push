#!/usr/bin/env sh
# BACKLOG 涵蓋閘：推上去的分支 tip 要帶 `Backlog-check`。邏輯在 `~/.agents/bin/backlog_trailers.py`
# （bare repo 的正本，GUB-017），git 交來的 ref 清單從 stdin 原樣傳過去。
# 找不到那份正本（cloud、新機器）就印一行說沒檢查，然後放行。
set -e
checker="$HOME/.agents/bin/backlog_trailers.py"
if [ ! -f "$checker" ]; then
  echo "pre-push: 找不到 $checker，BACKLOG 涵蓋沒有檢查。" >&2
  exit 0
fi
exec python3 "$checker" pre-push "$@"
