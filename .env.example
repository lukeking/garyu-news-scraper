# .env.example
# 複製成 .env 並填入實際值，用於本機測試
# .env 已加入 .gitignore，不會被 commit

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.0-flash
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_SENDER=your@gmail.com
SUPABASE_URL=https://your-project.supabase.co
# 本機寫入 articles 請用 service_role（與 Dashboard「service_role」secret 相同）；anon 會被 RLS 擋下
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_here
# 選填後備；未設定時 storage 僅讀此變數
# SUPABASE_KEY=
